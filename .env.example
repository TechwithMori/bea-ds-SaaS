# Copy to .env for local Docker Compose. Never commit real secrets.

DJANGO_SETTINGS_MODULE=core.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Inside Compose the host is "db". From the host machine use localhost.
DATABASE_URL=postgres://bea:bea@db:5432/bea_drops
POSTGRES_DB=bea_drops
POSTGRES_USER=bea
POSTGRES_PASSWORD=bea

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Access token lifetime in minutes; refresh in days.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Optional shared secret for supplier fulfillment webhooks.
SUPPLIER_WEBHOOK_SECRET=change-me-supplier-webhook-secret
